#===============================================================================
# stovol Makefile
#===============================================================================

OUTDIR = $(SRCPATH)/f/out

TARGET = stovol stovol_ut

# 顏色定義
GREEN = \033[0;32m
YELLOW = \033[1;33m
NC = \033[0m

#===============================================================================
# [預設說明]：不加參數時顯示說明
#===============================================================================
.DEFAULT_GOAL := usage

.PHONY: usage all clean $(TARGET)

usage:
	@echo ""
	@echo -e "$(YELLOW)===[ 使用說明 ]===$(NC)"
	@echo -e "$(GREEN)make all           $(NC)- 編譯所有程式 (使用 buildsome.sh)"
	@echo -e "$(GREEN)make <target>      $(NC)- 編譯指定程式，例如 make stovol"
	@echo -e "$(GREEN)make clean         $(NC)- 清除 out/ 及本目錄的編譯檔"
	@echo ""
	@echo -e "可用 target：$(TARGET)"
	@echo -e "$(YELLOW)===================================$(NC)"

#===============================================================================
# Build all targets
#===============================================================================
all: $(TARGET)

#===============================================================================
# 每個 target 的 build 動作
#===============================================================================
$(TARGET):
	@echo -e "$(YELLOW)==> Build $@$(NC)"
	ninja -C $(OUTDIR) opt/stovol:$@
	cp $(OUTDIR)/$@ .


#===============================================================================
# Clean
#===============================================================================
clean:
	@echo -e "$(YELLOW)==> 清除 out/ 及本目錄的編譯檔$(NC)"
	rm -f $(OUTDIR)/stovol $(OUTDIR)/stovol_ut
	rm -f stovol stovol_ut
